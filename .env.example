# Base URL de la API REST. En desarrollo apunta a MSW (relative, no se usa).
# En produccion: https://api.sigme-utp.pe/api
VITE_API_BASE_URL=/api

# URL del WebSocket de eventos en tiempo real (RFA03, RFA05, RFA11 / RNF02).
# En produccion debe ser wss:// para cumplir RNF06.
VITE_SOCKET_URL=ws://localhost:5173/socket.io

# false desactiva MSW y usa la API real. En desarrollo es true por defecto.
VITE_ENABLE_MOCK=true

# Entorno visible en la UI para no confundir demo con produccion.
VITE_APP_ENV=development
